{
  "name": "blueprint-front",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "gen:themes": "node scripts/gen-theme-registry.mjs",
    "gen:api": "openapi-typescript ${BLUEPRINT_OPENAPI:-../blueprint-back/openapi.json} -o src/core/api/schema.d.ts",
    "check:api": "node scripts/check-api-contract.mjs",
    "predev": "bun run gen:themes",
    "dev": "next dev -p 3100",
    "prebuild": "bun run gen:themes",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "bun run gen:themes && tsc --noEmit",
    "test:isolation": "playwright test tests/isolation.spec.ts",
    "test:required": "playwright test tests/required.spec.ts",
    "test:states": "BLUEPRINT_API_URL=http://127.0.0.1:4298 playwright test tests/states.spec.ts",
    "check:no-fetch": "node scripts/check-no-fetch.mjs"
  },
  "dependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@ant-design/icons": "6.3.4",
    "@ant-design/nextjs-registry": "1.3.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@internationalized/date": "3.12.4",
    "@mantine/core": "9.7.1",
    "@mantine/hooks": "9.7.1",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "@tabler/icons-react": "3.48.0",
    "antd": "6.6.5",
    "next": "16.3.6",
    "openapi-fetch": "0.17.0",
    "playwright-core": "1.64.0",
    "react": "19.3.0",
    "react-aria": "3.53.0",
    "react-aria-components": "1.22.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
