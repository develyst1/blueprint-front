# Copy to .env.local (git-ignored) if you want to change any of these. Everything is optional: a value shown here is the default the code uses, a commented line is off/unset by default. No secret belongs in this file.

# --- the app ---

# The port `bun run start` (and pm2) serves on; default 3100. A `-p <n>` argument wins over it.
# PORT=3100
# Where blueprint-back listens. The front reads every project through it.
BLUEPRINT_API_URL=http://127.0.0.1:4200
# Where the "ส่งไปสร้างที่ CAW" button on the ready screen opens: caw-front (its /start page).
CAW_URL=http://127.0.0.1:3500
# 1 = serve the development pages under /dev (samples, themes, layouts, loaders, isolation); unset = they answer 404. The Playwright config sets it for its own server.
# BLUEPRINT_DEV_PAGES=1
# The folder `next build` writes to and `next start` reads from. Several people share this checkout: each builds into their own (.next-a, .next-b, ...).
# NEXT_DIST_DIR=.next

# --- scripts (gen:api, check:api, check-required) ---

# Path of blueprint-back's openapi.json, for `bun run gen:api` and `bun run check:api`.
# BLUEPRINT_OPENAPI=../blueprint-back/openapi.json
# The blueprint-back folder the test seeds and fixtures are read from.
# BLUEPRINT_BACK=../blueprint-back

# --- tests only (Playwright and the required-content check) ---

# The browser channel the PDF export launches (default chrome). Only a test sets it, to a name that does not exist, to see the export fail cleanly.
# BLUEPRINT_PDF_CHROME_CHANNEL=
# Port of the production server the Playwright specs start; the default is 3100.
# PLAYWRIGHT_PORT=3100
# Folder for Playwright's own output; the default is test-results.
# PLAYWRIGHT_OUTPUT=test-results
# The front the required-content check (scripts/check-required.ts) visits; and the second port it uses for the extra run.
# CHECK_BASE_URL=http://127.0.0.1:3101
# CHECK_EXTRA_PORT=3102
# A file path: when set, the isolation spec also saves a screenshot of its page there (a tool for looking, not a check).
# ISOLATION_SCREENSHOT=
# The date tests set the time zone themselves (src/core/format/date.test.ts); do not set TZ here.
# TZ=
